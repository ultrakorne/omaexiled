# OmaExiled build. `make` (= `make build`) builds every part: the renderer,
# the Qt host, the fake game and the backend's packages. Each step only runs
# when its output is missing or older than its inputs, so running it again
# on a built tree is quick. See DESIGN.md "Build, run, test".

REPO     := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
RENDERER := $(REPO)/renderer
HOST     := $(REPO)/host
FAKE_POE := $(REPO)/tools/fake-poe
BACKEND  := $(REPO)/backend

RENDERER_DEPS := $(RENDERER)/node_modules/.package-lock.json

QMAKE ?= qmake6
NPM   ?= npm
NPX   ?= npx
BUN   ?= bun

# Generated by `npm run make-index-files` (src/assets/make-index-files.mjs)
# from each language's stats.ndjson and items.ndjson.
INDEX_LANGS := en ru cmn-Hant ko ja de es pt fr
INDEX_FILES := $(foreach l,$(INDEX_LANGS),$(addprefix $(RENDERER)/public/data/$(l)/,\
	stats-ref.index.bin stats-matcher.index.bin items-name.index.bin items-ref.index.bin))
INDEX_INPUTS := $(foreach l,$(INDEX_LANGS),$(RENDERER)/public/data/$(l)/stats.ndjson $(RENDERER)/public/data/$(l)/items.ndjson)

# Everything vite reads. The index files are listed separately: they only
# change (and only then trigger a rebuild) when their ndjson inputs do.
RENDERER_INPUTS := $(shell find $(RENDERER)/src $(RENDERER)/public $(REPO)/ipc -type f ! -name '*.index.bin' 2>/dev/null) \
	$(wildcard $(RENDERER)/index.html $(RENDERER)/package.json $(RENDERER)/vite.config.mts \
		$(RENDERER)/tailwind.config.js $(RENDERER)/tsconfig.json)

BACKEND_HAS_DEPS := $(shell jq -e '((.dependencies // {}) + (.devDependencies // {})) | length > 0' \
	$(BACKEND)/package.json >/dev/null 2>&1 && echo yes)

.PHONY: all build renderer host fake-poe backend test test-renderer test-backend clean distclean

all: build

build: renderer host fake-poe backend

# --- renderer (EE2's Vue app) -------------------------------------------------

renderer: $(RENDERER)/dist/index.html

# npm keeps a copy of the lockfile it installed in node_modules: a missing or
# older copy means node_modules is missing or out of date.
$(RENDERER_DEPS): $(RENDERER)/package-lock.json
	cd $(RENDERER) && $(NPM) ci
	touch $@

$(INDEX_FILES) &: $(INDEX_INPUTS) | $(RENDERER_DEPS)
	cd $(RENDERER) && $(NPM) run make-index-files

$(RENDERER)/dist/index.html: $(RENDERER_INPUTS) $(INDEX_FILES) $(RENDERER_DEPS)
	cd $(RENDERER) && $(NPX) vite build

# --- Qt host (overlay layer surface + settings window) ------------------------

host: $(HOST)/build/Makefile
	$(MAKE) -C $(HOST)/build

$(HOST)/build/Makefile: $(HOST)/omaexiled-host.pro
	mkdir -p $(HOST)/build
	cd $(HOST) && $(QMAKE) -o build/Makefile omaexiled-host.pro

# --- fake PoE2 window for tests -----------------------------------------------

fake-poe: $(FAKE_POE)/build/Makefile
	$(MAKE) -C $(FAKE_POE)/build

$(FAKE_POE)/build/Makefile: $(FAKE_POE)/fake-poe.pro
	mkdir -p $(FAKE_POE)/build
	cd $(FAKE_POE)/build && $(QMAKE) -o Makefile ../fake-poe.pro

# --- backend (Bun) --------------------------------------------------------------

ifeq ($(BACKEND_HAS_DEPS),yes)
backend: $(BACKEND)/node_modules/.omaexiled-installed

$(BACKEND)/node_modules/.omaexiled-installed: $(BACKEND)/package.json $(wildcard $(BACKEND)/bun.lock)
	cd $(BACKEND) && $(BUN) install
	touch $@
else
backend:
	@:
endif

# --- tests ----------------------------------------------------------------------

test: test-renderer test-backend

test-renderer: $(INDEX_FILES) $(RENDERER_DEPS)
	cd $(RENDERER) && $(NPX) vitest run

test-backend: backend
	cd $(BACKEND) && $(BUN) test

# --- cleanup --------------------------------------------------------------------

clean:
	rm -rf $(RENDERER)/dist $(HOST)/build $(FAKE_POE)/build
	rm -f $(INDEX_FILES)

distclean: clean
	rm -rf $(RENDERER)/node_modules $(BACKEND)/node_modules
